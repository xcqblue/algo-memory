    "llm": {
      "label": "LLM 配置",
      "description": "大语言模型相关配置"
    },
    "llm.enabled": {
      "label": "启用LLM",
      "description": "启用 LLM 增强功能"
    },
    "llm.provider": {
      "label": "模型提供商",
      "placeholder": "auto",
      "description": "如: minimax, deepseek, kimi 等"
    },
    "llm.apiKey": {
      "label": "API密钥",
      "sensitive": true,
      "description": "LLM 服务商 API Key"
    },
    "llm.model": {
      "label": "模型名称",
      "placeholder": "abab6.5s-chat"
    },
    "llm.baseURL": {
      "label": "API地址",
      "placeholder": "https://api.minimax.chat/v1"
    },
    "llm.customModelNames": {
      "label": "自定义模型名称",
