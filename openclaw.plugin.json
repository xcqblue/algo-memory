    "weibullDecay": {
      "label": "Weibull衰减",
      "description": "使用 Weibull 分布的时间衰减"
    },
    "weibullDecay.enabled": {
      "label": "启用Weibull衰减"
    },
    "weibullDecay.shape": {
      "label": "形状参数"
    },
    "weibullDecay.scale": {
      "label": "尺度参数"
    },
    "reinforcement": {
      "label": "访问强化",
      "description": "访问次数越多，重要性越高"
    },
    "reinforcement.enabled": {
      "label": "启用访问强化"
    },
    "reinforcement.factor": {
      "label": "强化因子"
    },
    "reinforcement.maxMultiplier": {
      "label": "最大倍数"
    },
    "mmr": {
      "label": "MMR去重",
      "description": "最大边际相关性去重"
    },
    "mmr.enabled": {
      "label": "启用MMR"
    },
    "mmr.threshold": {
      "label": "MMR阈值"
    },
    "mmr.lambda": {
      "label": "MMR相关性权重",
      "description": "1=只求相关，0=只求多样，推荐0.7"
    },
    "adaptiveRetrieval.sessionDedup": {
      "label": "会话去重",
      "description": "短时间相同查询不重复召回"
    },
    "adaptiveRetrieval.sessionDedup.enabled": {
      "label": "启用会话去重"
    },
    "adaptiveRetrieval.sessionDedup.windowMs": {
      "label": "去重窗口",
      "description": "毫秒内相同查询不重复召回"
    },
    "adaptiveRetrieval.sessionDedup.similarityThreshold": {
      "label": "去重相似度阈值"
    },
    "lengthNorm": {
      "label": "长度归一化",
      "description": "对长内容进行重要性归一化"
    },
    "lengthNorm.enabled": {
      "label": "启用长度归一化"
    },
    "lengthNorm.anchor": {
      "label": "锚点长度"
    },
    "hardMinScore": {
      "label": "最低分过滤",
      "description": "过滤低于阈值的记忆"
    },
    "hardMinScore.enabled": {
      "label": "启用最低分过滤"
    },
    "hardMinScore.threshold": {
      "label": "最低分阈值"
    },
      "label": "分层管理",
      "description": "核心/工作/外围记忆分层"
    },
    "tier.enabled": {
      "label": "启用分层管理"
    },
    "tier.coreThreshold": {
      "label": "核心阈值"
    },
    "tier.peripheralThreshold": {
      "label": "外围阈值"
    },
    "tier.ageDays": {
      "label": "老化天数"
    }
  },
  "requirements": {
    "node": ">=20.0.0",
    "openclaw": ">=2026.3.0"
  }
}