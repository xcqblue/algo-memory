{
  "id": "algo-memory",
  "name": "algo-memory",
  "description": "Structured SQLite-based memory for OpenClaw — tier scoring (core/working/peripheral), FTS5 full-text search, Weibull decay, session continuity, compaction reinforcement. Compatible with OpenClaw v2026.3.23+. Mutually exclusive with memory-lancedb: set plugins.slots.memory='algo-memory' to activate.",
  "version": "2.7.0",
  "kind": "memory",
  "homepage": "https://github.com/xcqblue/algo-memory",
  "installDependencies": true,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "autoCapture": {
        "type": "boolean",
        "default": true,
        "description": "自动捕获对话记忆"
      },
      "autoRecall": {
        "type": "boolean",
        "default": true,
        "description": "自动召回相关记忆"
      },
      "maxResults": {
        "type": "number",
        "default": 5,
        "description": "召回结果数量"
      },
      "cleanupDays": {
        "type": "number",
        "default": 180,
        "description": "记忆保留天数"
      },
      "language": {
        "type": "string",
        "default": "auto",
        "description": "语言: auto, zh, en, ja, ko, es, fr, de"
      },
      "coreKeywords": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "核心关键词列表"
      },
      "recencyDecay": {
        "type": "boolean",
        "default": true,
        "description": "启用时间衰减"
      },
      "recencyHalfLife": {
        "type": "number",
        "default": 180,
        "description": "半衰期(天)"
      },
      "smartDedup": {
        "type": "boolean",
        "default": true,
        "description": "启用智能去重"
      },
      "dedupThreshold": {
        "type": "number",
        "default": 0.85,
        "description": "去重阈值"
      },
      "capturePerTurn": {
        "type": "number",
        "default": 3,
        "description": "每轮最多写入数"
      },
      "scopes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "启用隔离模式"
          },
          "defaultScope": {
            "type": "string",
            "default": "agent",
            "description": "默认作用域"
          },
          "visibleAgents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "允许查看的Agent列表"
          }
        }
      },
      "weibullDecay": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "shape": {
            "type": "number",
            "default": 1.5
          },
          "scale": {
            "type": "number",
            "default": 90
          }
        }
      },
      "reinforcement": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "factor": {
            "type": "number",
            "default": 0.5
          },
          "maxMultiplier": {
            "type": "number",
            "default": 3
          }
        }
      },
      "mmr": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "threshold": {
            "type": "number",
            "default": 0.85
          },
          "lambda": {
            "type": "number",
            "default": 0.7
          }
        }
      },
      "lengthNorm": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "anchor": {
            "type": "number",
            "default": 500
          }
        }
      },
      "hardMinScore": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "threshold": {
            "type": "number",
            "default": 0.35
          }
        }
      },
      "tier": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "coreThreshold": {
            "type": "number",
            "default": 10
          },
          "peripheralThreshold": {
            "type": "number",
            "default": 0.15
          },
          "ageDays": {
            "type": "number",
            "default": 60
          }
        }
      },
      "llm": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "启用LLM"
          },
          "provider": {
            "type": "string",
            "default": "auto",
            "description": "模型提供商"
          },
          "apiKey": {
            "type": "string",
            "default": "",
            "description": "API密钥"
          },
          "model": {
            "type": "string",
            "default": "",
            "description": "模型名称"
          },
          "baseURL": {
            "type": "string",
            "default": "",
            "description": "API地址"
          },
          "customModelNames": {
            "type": "object",
            "default": {},
            "description": "自定义模型名称映射（key=API模型名，value=显示名）。用于新增模型或覆盖内置映射，无需更新插件代码即可支持新模型。示例: {\"glm-4.7-flash\": \"智谱免费模型\"}"
          }
        }
      },
      "threshold": {
        "type": "object",
        "properties": {
          "useLlmForCore": {
            "type": "boolean",
            "default": false,
            "description": "LLM判断核心记忆"
          },
          "useLlmForExtract": {
            "type": "boolean",
            "default": false,
            "description": "LLM提取关键词"
          },
          "useLlmForDedup": {
            "type": "boolean",
            "default": false,
            "description": "LLM去重判断"
          },
          "minConfidence": {
            "type": "number",
            "default": 0.8,
            "description": "最小置信度"
          },
          "lengthForCore": {
            "type": "number",
            "default": 100,
            "description": "触发LLM核心判断的长度阈值"
          },
          "lengthForExtract": {
            "type": "number",
            "default": 200,
            "description": "触发LLM关键词提取的长度阈值"
          },
          "dedupUncertaintyMin": {
            "type": "number",
            "default": 0.5,
            "description": "去重不确定区间最小值"
          },
          "dedupUncertaintyMax": {
            "type": "number",
            "default": 0.98,
            "description": "去重不确定区间最大值"
          }
        }
      },
      "noiseFilter": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "skipGreetings": {
            "type": "boolean",
            "default": true
          },
          "skipCommands": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "adaptiveRetrieval": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "minQueryLength": {
            "type": "number",
            "default": 2
          },
          "forceKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "记住",
              "之前",
              "上次",
              "记得",
              "remember",
              "before",
              "last",
              "前",
              "上次",
              "what",
              "why",
              "how",
              "什么",
              "为什么",
              "怎么"
            ]
          },
          "sessionDedup": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "windowMs": {
                "type": "number",
                "default": 30000
              },
              "similarityThreshold": {
                "type": "number",
                "default": 0.75
              }
            }
          }
        }
      }
    }
  },
  "uiHints": {
    "category": "memory",
    "tags": [
      "记忆",
      "长期记忆",
      "向量",
      "无LLM"
    ],
    "preview": "纯算法实现，智能自动召回，无需 LLM 也能工作的长期记忆系统",
    "autoCapture": {
      "label": "自动捕获",
      "description": "自动捕获对话中的重要信息"
    },
    "autoRecall": {
      "label": "自动召回",
      "description": "在对话时自动召回相关记忆"
    },
    "maxResults": {
      "label": "召回数量",
      "description": "每次召回的记忆条数"
    },
    "cleanupDays": {
      "label": "保留天数",
      "description": "记忆保留的天数"
    },
    "language": {
      "label": "语言",
      "placeholder": "auto",
      "description": "支持: auto, zh, en, ja, ko, es, fr, de"
    },
    "coreKeywords": {
      "label": "核心关键词",
      "description": "触发核心记忆的关键词列表"
    },
    "recencyDecay": {
      "label": "时间衰减",
      "description": "启用时间衰减算法"
    },
