{
  "name": "algo-memory",
  "version": "3.1.0",
  "description": "纯算法长期记忆插件 - 默认启用LLM / 支持多模型",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "src",
    "dist",
    "openclaw.plugin.json",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "memory",
    "long-term-memory",
    "algo"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sinclair/typebox": "^0.32.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0",
    "https-proxy-agent": "^8.0.0",
    "lru-cache": "^7.18.3",
    "proxy-agent": "^7.0.0",
    "undici": "^7.24.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "openclaw": {
    "id": "algo-memory",
    "extensions": [
      "./dist/index.js"
    ],
    "installDependencies": true
  }
}
